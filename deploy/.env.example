# Copy to the project root as .env (never commit it).
DOMAIN=prebot.example.com
PUSH_SUBJECT=mailto:you@example.com

# Optional: login providers (see README). Add https://DOMAIN/signin-google and /signin-discord as redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: only for `docker compose --profile discord up`
DISCORD_BOT_TOKEN=
