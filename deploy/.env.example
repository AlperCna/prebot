# Copy to the project root as .env (never commit it).
DOMAIN=prebot.example.com
PUSH_SUBJECT=mailto:you@example.com

# Optional: login providers (see README). Add https://DOMAIN/signin-google and /signin-discord as redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord bot token: hosted inside the website when set (recommended)
DISCORD_BOT_TOKEN=

# Optional: channels where website listings are announced (comma-separated channel ids)
DISCORD_FEED_CHANNELS=

# Optional: ping URL that the nightly backup calls on success (e.g. https://hc-ping.com/<uuid>)
BACKUP_HEARTBEAT_URL=
