{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PreBot": "Data Source=prebot-web.db"
  },
  "PreBot": {
    "ListingMinutes": 15,
    "ReopenMinutes": 10,
    "PingCooldownMinutes": 15,
    "MaxSlotsPerListing": 3,
    "SweepIntervalSeconds": 10
  }
}
