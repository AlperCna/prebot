{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PreBot": {
    "ListingMinutes": 15,
    "ReopenMinutes": 10,
    "PingCooldownMinutes": 3,
    "MaxSlotsPerListing": 3,
    "SweepIntervalSeconds": 10
  }
}
