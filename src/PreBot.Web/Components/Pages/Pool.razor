@page "/havuz"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits UserComponentBase
@inject SubscriptionService Subscriptions

<PageTitle>Havuz · PreBot</PageTitle>

@if (Account is null)
{
    return;
}

<WaveAlertBanner UserId="UserId" />

<h1 class="h3 mb-3">Havuz</h1>

<GettingStarted UserId="UserId" HasRiotId="@(_riotId is not null)" HasPush="@(_pushDevices > 0)"
                HasWay="@(_availability is not null || _alertOn)" OnChanged="LoadAsync" />

<div class="mb-3">
    <PushToggle UserId="UserId" Compact="true" />
</div>

@if (_inGameUntil is { } inGameUntil)
{
    <div class="pb-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="fw-semibold"><Icon Name="clock" /> Maçtasın</div>
                <div class="text-dim small">
                    @Format.TimeLeft(inGameUntil) boyunca ilan bildirimi göndermiyorum; sonra sana uyan açık bir ilan varsa haber vereceğim.
                </div>
            </div>
            <button class="btn btn-sm btn-gold" disabled="@(_busy || !Ready)" @onclick="MatchFinishedAsync">Maç bitti, hazırım</button>
        </div>
    </div>
}

@if (_availability is { } a)
{
    <div class="pb-card status-live">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="fw-semibold"><span class="dot"></span>Havuzdasın: @Format.RoleLabel(a.Role) · @TurkishNames.Of(a.Rank)</div>
                <div class="text-dim small">
                    @Format.TimeLeft(a.ExpiresAtUtc) sonra kendiliğinden çıkacaksın. Uygun ilan açılınca haber vereceğim@(_pushDevices > 0 ? " (site kapalıyken de bildirimle)" : "; bildirimleri açarsan site kapalıyken de").
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" disabled="@(_busy || !Ready)" @onclick="() => SetAvailableAsync(a.Role, a.Rank, MinutesLeft(a) + 60)">+1 saat</button>
                <button class="btn btn-sm btn-outline-danger" disabled="@(_busy || !Ready)" @onclick="ClearAsync">Havuzdan çık</button>
            </div>
        </div>
        @if (_riotId is null)
        {
            <RiotIdPrompt UserId="UserId" Hint="Bir ilana katılınca sahibi seni oyunda bununla davet edecek." OnSaved="_ => LoadAsync()" />
        }
    </div>
}
else
{
    <div class="pb-card">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label">Rol</label>
                <select class="form-select" @bind="_role">
                    @foreach (var r in Format.Roles)
                    {
                        <option value="@r">@Format.RoleOption(r)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">Flex rankın</label>
                <select class="form-select" @bind="_rank">
                    @foreach (var k in Format.Ranks)
                    {
                        <option value="@k">@TurkishNames.Of(k)</option>
                    }
                </select>
            </div>
        </div>

        @if (!_alertOn)
        {
            <div class="mt-3">
                <button class="btn btn-gold" disabled="@(_busy || !Ready)" @onclick="QuickAlertAsync"><Icon Name="bell" /> Akşamları bana haber ver</button>
                <div class="text-dim small mt-1">
                    19:00–00:00 arası sana uyan bir ilan açılınca haber gelir; her akşam bir şey yapman gerekmez.
                    Saatleri <a href="/bildirimler">Bildirimler</a>'den değiştirebilirsin.
                </div>
            </div>
        }
        else
        {
            <div class="text-dim small mt-2"><Icon Name="check" /> "Bana haber ver" açık. <a href="/bildirimler">Ayarlar</a></div>
        }

        <div class="d-flex flex-wrap gap-2 align-items-end mt-3">
            <div>
                <label class="form-label small text-dim mb-1">Şu an oynayabiliyorsan, önce sana sorulsun</label>
                <select class="form-select" @bind="_minutes">
                    <option value="30">30 dakika</option>
                    <option value="60">1 saat</option>
                    <option value="120">2 saat</option>
                </select>
            </div>
            <button class="btn @(_alertOn ? "btn-gold" : "btn-outline-light")" disabled="@(_busy || !Ready)" @onclick="() => SetAvailableAsync(_role, _rank, _minutes)">Şu an müsaitim</button>
        </div>
    </div>
}

<div class="section-title">Şu an müsait (@_summary.Total kişi)</div>
@if (_summary.Total == 0)
{
    <p class="text-dim">Havuz şu an boş. Akşamları dolmaya başlar. İlk sen gir!</p>
}
else
{
    <div>
        @foreach (var (role, count) in _summary.ByRole.Where(kv => kv.Value > 0))
        {
            <span class="role-chip">@Format.RoleLabel(role): <strong>@count</strong></span>
        }
    </div>
}

@if (_mine.Count > 0)
{
    <div class="section-title">Senin ilanların</div>
    @foreach (var view in _mine)
    {
        <ListingCard View="view" Names="_names" UserId="UserId" Highlight="true" />
    }
}

<div class="d-flex justify-content-between align-items-end">
    <div class="section-title">Açık ilanlar</div>
    <a class="btn btn-sm btn-gold mb-2" href="/ilan-ac"><Icon Name="plus" /> İlan aç</a>
</div>

@if (_open.Count == 0)
{
    <p class="text-dim">Şu an açık ilan yok.</p>
}
else
{
    @foreach (var view in _open)
    {
        <ListingCard View="view" Names="_names" UserId="UserId" OnJoin="JoinAsync" Busy="@(_busy || !Ready)" />
    }
}

@if (_message is not null)
{
    <div class="alert alert-warning mt-3">@_message</div>
}

@code {
    private Availability? _availability;
    private string? _riotId;
    private int _pushDevices;
    private bool _alertOn;
    private PoolSummary _summary = new(0, new Dictionary<Role, int>());
    private IReadOnlyList<ListingView> _open = [];
    private IReadOnlyList<ListingView> _mine = [];
    private IReadOnlyDictionary<ulong, string> _names = new Dictionary<ulong, string>();
    private Role _role = Role.Support;
    private Rank _rank = Rank.Gold;
    private int _minutes = 60;
    private DateTime? _inGameUntil;
    private bool _busy;
    private string? _message;

    protected override async Task LoadAsync()
    {
        _availability = await Pre.GetAvailabilityAsync(Communities.Web, UserId);
        _inGameUntil = await Pre.GetInGameUntilAsync(UserId);
        _riotId = await Pre.GetRiotIdAsync(UserId);
        _pushDevices = await Subscriptions.CountPushDevicesAsync(UserId);
        _alertOn = (await Subscriptions.GetAlertAsync(Communities.Web, UserId))?.Enabled == true;
        _summary = await Pre.GetPoolSummaryAsync(Communities.Web);
        _mine = await Pre.GetMyListingsAsync(Communities.Web, UserId);
        var mineIds = _mine.Select(v => v.Listing.Id).ToHashSet();
        _open = (await Pre.GetOpenListingsAsync(Communities.Web)).Where(v => !mineIds.Contains(v.Listing.Id)).ToList();
        _names = await Accounts.GetDisplayNamesAsync(_open.Concat(_mine).Select(v => v.Listing.HostUserId));

        if (_availability is { } a)
        {
            _role = a.Role;
            _rank = a.Rank;
        }
    }

    private static int MinutesLeft(Availability a) =>
        Math.Max(0, (int)Math.Ceiling((a.ExpiresAtUtc - DateTime.UtcNow).TotalMinutes));

    private async Task SetAvailableAsync(Role role, Rank rank, int minutes)
    {
        _busy = true;
        await Actions.SetAvailableAsync(UserId, role, rank, TimeSpan.FromMinutes(minutes));
        await LoadAsync();
        _busy = false;
    }

    private async Task QuickAlertAsync()
    {
        _busy = true;
        await Actions.QuickAlertAsync(UserId, _role, _rank);
        await LoadAsync();
        _busy = false;
    }

    private async Task MatchFinishedAsync()
    {
        _busy = true;
        await Actions.MatchFinishedAsync(UserId);
        await LoadAsync();
        _busy = false;
    }

    private async Task ClearAsync()
    {
        _busy = true;
        await Actions.ClearAvailableAsync(UserId);
        await LoadAsync();
        _busy = false;
    }

    private async Task JoinAsync(int listingId)
    {
        _busy = true;
        _message = null;
        var outcome = await Actions.ClaimAsync(listingId, UserId);
        _busy = false;
        if (outcome.Result is ClaimResult.Claimed or ClaimResult.ClaimedAndFilled)
        {
            Navigation.NavigateTo($"/ilan/{listingId}");
            return;
        }

        _message = outcome.Result switch
        {
            ClaimResult.RateLimited => ActionLimiter.RetryMessage(outcome.RetryAfter),
            ClaimResult.NeedsRiotId => "Katılmak için önce Riot ID'ni kaydet; ilan sahibi seni oyunda onunla davet edecek.",
            ClaimResult.HoldsOtherSeat => "Başka bir açık ilanda yerin var. Önce oradan vazgeç.",
            ClaimResult.Full => "Biri senden önce davrandı, kadro doldu.",
            ClaimResult.AlreadyJoined => "Bu ilana zaten katıldın ya da az önce ayrıldın.",
            _ => "Bu ilan artık açık değil.",
        };
    }
}
