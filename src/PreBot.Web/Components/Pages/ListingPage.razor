@page "/ilan/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits UserComponentBase
@inject IJSRuntime JS

<PageTitle>İlan · PreBot</PageTitle>

@if (Account is null)
{
    return;
}

<WaveAlertBanner UserId="UserId" />

@if (_view is null)
{
    <div class="pb-card">
        <h1 class="h4">İlan bulunamadı</h1>
        <p class="text-dim mb-0">Silinmiş olabilir. <a href="/havuz">Havuza dön</a>.</p>
    </div>
    return;
}

@{
    var l = _view.Listing;
    var isHost = l.HostUserId == UserId;
    var joined = _view.ActiveSlots.Any(s => s.UserId == UserId);
    var insider = isHost || joined;
    var left = !joined && _view.LeftUserIds.Contains(UserId);
    var missing = l.SlotsNeeded - l.SlotsFilled;
}

@if (Yeni is int matches && isHost && l.Status == ListingStatus.Open)
{
    <div class="alert alert-success">
        📢 İlanın açıldı.
        @(matches == 0
            ? "Şu an havuzda uygun kimse yok. İlan açık kaldıkça yeni gelenlere haber vereceğim; linki arkadaşlarınla da paylaşabilirsin."
            : $"Havuzda {matches} uygun kişi var, en uygunlardan başlayarak haber veriyorum.")
    </div>
}

<div class="pb-card @(l.Status == ListingStatus.Open ? "listing-card highlight" : "")">
    <div class="text-dim small mb-1">
        @(l.Status switch
        {
            ListingStatus.Open => $"🔎 Açık · {missing} kişi eksik · kapanış {Format.TimeLeft(l.ExpiresAtUtc)}",
            ListingStatus.Filled => "✅ Kadro tamam, iyi oyunlar!",
            ListingStatus.Expired => "⌛ İlanın süresi doldu",
            _ => "🚫 İlan kapatıldı",
        })
    </div>
    <h1 class="h3 mb-1">@Format.RoleLabel(l.Role) lazım</h1>
    <div class="mb-2">
        <span class="rank-chip ms-0">@TurkishNames.RankRange(l.MinRank, l.MaxRank)</span>
        <span class="rank-chip">@l.SlotsFilled / @l.SlotsNeeded dolu</span>
    </div>
    @if (l.Note is not null)
    {
        <div class="listing-note mb-2">“@l.Note”</div>
    }

    <div class="section-title mt-3">İlan sahibi</div>
    <div>
        <strong>@_names.GetValueOrDefault(l.HostUserId, "Bir oyuncu")</strong>
        @if (insider)
        {
            <RiotIdBadge RiotId="@_view.HostRiotId" Hint="@(isHost ? "Profilinden Riot ID'ni ekle ki katılanlar seni bulsun." : "Ona Riot ID'sini sor.")" />
        }
    </div>

    <div class="section-title">Katılanlar</div>
    @if (_view.ActiveSlots.Count == 0)
    {
        <div class="text-dim">Henüz kimse yok.</div>
    }
    else
    {
        @foreach (var slot in _view.ActiveSlots)
        {
            <div class="mb-1">
                <strong>@_names.GetValueOrDefault(slot.UserId, "Bir oyuncu")</strong>
                @if (insider)
                {
                    <RiotIdBadge RiotId="@slot.RiotId" Hint="Riot ID kayıtlı değil, kendisine sor." />
                }
            </div>
        }
    }

    @if (isHost && _view.ActiveSlots.Count > 0)
    {
        <div class="alert alert-info small mt-3 mb-0">Oyunda <strong>Arkadaş ekle</strong> → Riot ID'yi yaz → lobine davet et.</div>
    }
    @if (left && l.Status == ListingStatus.Open)
    {
        <div class="alert alert-secondary small mt-3 mb-0">Bu ilandan ayrıldın, yerin başkasına açıldı. Aynı ilana tekrar katılamazsın.</div>
    }
    @if (joined)
    {
        <div class="alert alert-info small mt-3 mb-0">İlan sahibi seni davet edecek. Gelemeyeceksen lütfen <strong>Vazgeç</strong>'e bas, başkası alsın.</div>
    }

    @if (_message is not null)
    {
        <div class="alert alert-warning mt-3 mb-0">@_message</div>
    }

    <div class="d-flex flex-wrap gap-2 mt-3">
        @if (l.Status == ListingStatus.Open && !insider && !left)
        {
            <button class="btn btn-gold btn-lg" disabled="@_busy" @onclick="JoinAsync">Katıl</button>
        }
        @if (joined && l.Status is ListingStatus.Open or ListingStatus.Filled)
        {
            <button class="btn btn-outline-light" disabled="@_busy" @onclick="LeaveAsync">Vazgeç</button>
        }
        @if (isHost && l.Status is ListingStatus.Open or ListingStatus.Filled)
        {
            @if (_view.ActiveSlots.Count > 0)
            {
                <button class="btn btn-outline-light" disabled="@_busy" @onclick="NoShowAsync">Gelmedi, yeniden ara</button>
            }
            <button class="btn btn-outline-danger" disabled="@_busy" @onclick="CancelAsync">İlanı kapat</button>
        }
        @if (l.Status == ListingStatus.Open)
        {
            <button class="btn btn-outline-light" @onclick="CopyLinkAsync">@(_copied ? "Kopyalandı ✓" : "🔗 Linki paylaş")</button>
        }
        <a class="btn btn-link" href="/havuz">Havuza dön</a>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public int? Yeni { get; set; }

    private ListingView? _view;
    private IReadOnlyDictionary<ulong, string> _names = new Dictionary<ulong, string>();
    private bool _busy;
    private bool _copied;
    private string? _message;

    protected override async Task LoadAsync()
    {
        _view = await Pre.GetListingViewAsync(Id);
        if (_view is not null && _view.Listing.GuildId != Communities.Web)
        {
            _view = null; // Discord-server listings are not shown on the website.
        }

        if (_view is not null)
        {
            _names = await Accounts.GetDisplayNamesAsync(
                _view.ActiveSlots.Select(s => s.UserId).Append(_view.Listing.HostUserId));
        }
    }

    private async Task RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _message = null;
        _message = await action();
        _busy = false;
    }

    private Task JoinAsync() => RunAsync(async () =>
        (await Actions.ClaimAsync(Id, UserId)).Result switch
        {
            ClaimResult.Claimed or ClaimResult.ClaimedAndFilled => null,
            ClaimResult.Full => "Biri senden önce davrandı, kadro doldu.",
            ClaimResult.AlreadyJoined => "Bu ilandan daha önce ayrıldın, tekrar katılamazsın.",
            _ => "Bu ilan artık açık değil.",
        });

    private Task LeaveAsync() => RunAsync(async () =>
        await Actions.LeaveAsync(Id, UserId) == LeaveResult.Left ? null : "Bu ilanda yerin yok.");

    private Task NoShowAsync() => RunAsync(async () =>
        (await Actions.ReportNoShowAsync(Id, UserId)).Result == HostActionResult.Done
            ? null
            : "Çıkarılacak kimse yok.");

    private Task CancelAsync() => RunAsync(async () =>
        (await Actions.CancelAsync(Id, UserId)).Result == HostActionResult.Done ? null : "İlan zaten kapalı.");

    private async Task CopyLinkAsync()
    {
        _copied = await JS.InvokeAsync<bool>("prebot.copy", Navigation.ToAbsoluteUri($"/ilan/{Id}").ToString());
    }
}
