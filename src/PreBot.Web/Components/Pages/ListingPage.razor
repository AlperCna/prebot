@page "/ilan/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits UserComponentBase
@inject IJSRuntime JS
@inject PreBot.Web.Push.JoinTokens JoinTokens
@inject ModerationService Moderation
@inject ActionLimiter Limiter

<PageTitle>İlan · PreBot</PageTitle>

@if (Account is null)
{
    return;
}

<WaveAlertBanner UserId="UserId" />

@if (_view is null)
{
    <div class="pb-card">
        <h1 class="h4">İlan bulunamadı</h1>
        <p class="text-dim mb-0">Silinmiş olabilir. <a href="/havuz">Havuza dön</a>.</p>
    </div>
    return;
}

@{
    var l = _view.Listing;
    var isHost = l.HostUserId == UserId;
    var joined = _view.ActiveSlots.Any(s => s.UserId == UserId);
    var insider = isHost || joined;
    var left = !joined && _view.LeftUserIds.Contains(UserId);
    var missing = l.SlotsNeeded - l.SlotsFilled;
    var active = l.Status is ListingStatus.Open or ListingStatus.Filled;
    var myRiotId = isHost ? _view.HostRiotId : _view.ActiveSlots.FirstOrDefault(s => s.UserId == UserId)?.RiotId;
}

@if (Yeni is int matches && isHost && l.Status == ListingStatus.Open)
{
    <div class="alert alert-success">
        <strong>İlanın açıldı.</strong>
        @(matches == 0
            ? "Şu an havuzda uygun kimse yok. İlan açık kaldıkça yeni gelenlere haber vereceğim; linki arkadaşlarınla da paylaşabilirsin."
            : $"Havuzda {matches} uygun kişi var, en uygunlardan başlayarak haber veriyorum.")
    </div>
}

<div class="pb-card @(l.Status == ListingStatus.Open ? "listing-card highlight" : "")">
    <div class="status-line mb-2">
        @switch (l.Status)
        {
            case ListingStatus.Open:
                <span class="status-pill open">Açık</span>
                <span>@missing kişi eksik · <Icon Name="clock" /> @Format.TimeLeft(l.ExpiresAtUtc)</span>
                break;
            case ListingStatus.Filled:
                <span class="status-pill done">Kadro tamam</span>
                <span>İyi oyunlar!</span>
                break;
            case ListingStatus.Expired:
                <span class="status-pill">Süresi doldu</span>
                break;
            default:
                <span class="status-pill">Kapatıldı</span>
                break;
        }
    </div>
    <h1 class="h3 mb-1">@Format.RoleLabel(l.Role) lazım</h1>
    <div class="mb-2">
        <span class="rank-chip ms-0">@TurkishNames.RankRange(l.MinRank, l.MaxRank)</span>
        <span class="rank-chip">@l.SlotsFilled / @l.SlotsNeeded dolu</span>
    </div>
    @if (l.Note is not null)
    {
        <div class="listing-note mb-2">“@l.Note”</div>
    }

    <div class="section-title mt-3">İlan sahibi</div>
    <div>
        <strong>@_names.GetValueOrDefault(l.HostUserId, "Bir oyuncu")</strong>
        @if (insider)
        {
            <RiotIdBadge RiotId="@_view.HostRiotId" Hint="@(isHost ? "Riot ID'ni aşağıdan ekle ki katılanlar seni bulsun." : "Riot ID'sini kaydetmemiş.")" />
        }
    </div>

    <div class="section-title">Katılanlar</div>
    @if (_view.ActiveSlots.Count == 0)
    {
        <div class="text-dim">Henüz kimse yok.</div>
    }
    else
    {
        @foreach (var slot in _view.ActiveSlots)
        {
            <div class="mb-2">
                <strong>@_names.GetValueOrDefault(slot.UserId, "Bir oyuncu")</strong>
                @if (insider)
                {
                    <span class="small text-dim ms-1">@Declared(slot)</span>
                    <RiotIdBadge RiotId="@slot.RiotId" Hint="Riot ID kayıtlı değil, kendisine sor." ProfileHref="@(isHost ? $"/git/opgg/{Id}/{slot.UserId}" : null)" />
                }
                @if (isHost && _noShows.GetValueOrDefault(slot.UserId) is var missed && missed > 0)
                {
                    <span class="small text-warning ms-1" title="Daha önceki ilanlarda ilan sahipleri 'Gelmedi' dedi"><Icon Name="alert" /> daha önce @missed kez gelmedi</span>
                }
                @if (isHost && active)
                {
                    var canNoShow = Now - slot.ClaimedAtUtc >= PreService.NoShowAfter;
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        <button class="btn btn-sm btn-outline-light" disabled="@(_busy || !Ready)" @onclick="() => DeclineAsync(slot.UserId)"
                                title="Başka biriyle devam et. Oyuncunun kaydına 'gelmedi' yazılmaz.">Uygun değil, sıradaki</button>
                        <button class="btn btn-sm btn-outline-light" disabled="@(_busy || !Ready || !canNoShow)" @onclick="() => NoShowAsync(slot.UserId)"
                                title="@(canNoShow ? "Davet ettin ama gelmedi: yeri boşalt, yeniden ara." : "Katıldıktan 3 dakika sonra açılır; önce daveti kabul etmesi için zaman tanı.")">Gelmedi</button>
                    </div>
                }
            </div>
        }
    }

    @if (l.LobbyCode is { } lobbyCode && l.Status == ListingStatus.Open)
    {
        var lobbyName = Lobby.Name(l.Role, lobbyCode);
        @if (isHost)
        {
            <div class="lobby-box mt-3">
                <div class="fw-semibold mb-1"><Icon Name="gamepad" /> Oyunda özel lobini aç</div>
                <div class="small text-dim mb-2">Oyna → Özel Oyun → Oluştur. Bildirim alan ve o an oyunda olan biri lobine direkt girer.</div>
                <div class="d-flex flex-wrap gap-2 align-items-center small">
                    Lobi adı: <button type="button" class="rank-chip riot-copy ms-0" data-copy="@lobbyName">@lobbyName <span class="copy-hint">kopyala</span></button>
                    @if (l.LobbyPassword is { } lobbyPassword)
                    {
                        <span>Şifre: <button type="button" class="rank-chip riot-copy ms-0" data-copy="@lobbyPassword">@lobbyPassword <span class="copy-hint">kopyala</span></button></span>
                    }
                </div>
                <button class="btn btn-sm btn-outline-light mt-2" disabled="@(_busy || !Ready)" @onclick="FilledViaLobbyAsync">
                    <Icon Name="check" /> @(missing > 1 ? "Lobiden biri geldi (1 kişi eksildi)" : "Lobiden biri geldi, ilanı kapat")
                </button>
            </div>
        }
        else if (!insider)
        {
            <div class="lobby-box mt-3 small">
                <Icon Name="gamepad" /> Şu an oyundaysan: <strong>Özel oyuna katıl</strong>, <strong>@lobbyName</strong>@(l.LobbyLocked ? " (şifreli; şifre sana gelen PreBot bildiriminde)" : "")
            </div>
        }
    }

    @if (isHost && active && _waiting.Count > 0)
    {
        <div class="small text-dim mt-2">
            <Icon Name="clock" /> @_waiting.Count kişi maçta olduğunu söyledi; bitince bu ilanı ona yeniden göstereceğim
            (en erken @Format.TimeLeft(_waiting.EarliestBackUtc!.Value) sonra). İlan o sırada kapanmışsa tekrar açabilirsin.
        </div>
    }

    @if (isHost && _view.ActiveSlots.Count > 0)
    {
        <div class="alert alert-info small mt-3 mb-0">
            Katılanın Riot ID'sine dokun (kopyalanır) → oyunda <strong>Arkadaş ekle</strong>'ye yapıştır → lobine davet et.
            <span class="d-block mt-1 text-dim">
                Ranklar beyan, doğrulanmıyor: <strong>op.gg</strong>'ye tek dokunuşla bak. Uymuyorsa <strong>Uygun değil, sıradaki</strong>
                de; kaydına "gelmedi" yazılmaz. <strong>Gelmedi</strong>'yi yalnızca davet ettiğin hâlde gelmeyen için kullan.
            </span>
        </div>
    }
    @if (left && l.Status == ListingStatus.Open)
    {
        <div class="alert alert-secondary small mt-3 mb-0">Bu ilanda artık yerin yok, yer başkasına açıldı. Aynı ilana tekrar katılamazsın; <a href="/havuz">havuza dönersen</a> sıradaki uygun ilanda yine haber veririm.</div>
    }
    @if (joined)
    {
        <div class="alert alert-info small mt-3 mb-0">
            İlan sahibi seni oyunda davet edecek; arkadaşlık isteği gelince kabul et. Beklemek istemezsen onun Riot ID'sine dokunup
            sen ekle. Gelemeyeceksen lütfen <strong>Vazgeç</strong>'e bas, başkası alsın.
        </div>
    }
    @if (!insider && !left && l.Status == ListingStatus.Open && _viewerRiotId is null)
    {
        <RiotIdPrompt UserId="UserId"
                      Hint="Katılmak için gerekli: ilan sahibi seni oyunda bununla davet edecek."
                      OnSaved="riot => _viewerRiotId = riot" />
    }
    @if (insider && active && myRiotId is null)
    {
        <RiotIdPrompt UserId="UserId"
                      Hint="@(isHost ? "Katılanlar seni oyunda bununla bulacak." : "İlan sahibi seni oyunda bununla davet edecek.")"
                      OnSaved="_ => LoadViewAsync()" />
    }

    @if (_message is not null)
    {
        <div class="alert alert-warning mt-3 mb-0">@_message</div>
    }

    <div class="d-flex flex-wrap gap-2 mt-3">
        @if (l.Status == ListingStatus.Open && !insider && !left)
        {
            <button class="btn btn-gold btn-lg" disabled="@(_busy || !Ready)" @onclick="JoinAsync">Katıl</button>
            <button class="btn btn-outline-light" disabled="@(_busy || !Ready)" @onclick="InGameAsync"
                    title="Şu an maçtaysan: yaklaşık 25 dakika bildirim gelmez, sonra bu ilan hâlâ açıksa ya da sana uyan başka biri varsa haber gelir.">
                <Icon Name="clock" /> Maçtayım, bitince haber ver
            </button>
        }
        @if (joined && l.Status is ListingStatus.Open or ListingStatus.Filled)
        {
            <button class="btn btn-outline-light" disabled="@(_busy || !Ready)" @onclick="LeaveAsync">Vazgeç</button>
        }
        @if (isHost && l.Status is ListingStatus.Open or ListingStatus.Filled)
        {
            <button class="btn btn-outline-danger" disabled="@(_busy || !Ready)" @onclick="CancelAsync">İlanı kapat</button>
        }
        @if (isHost && l.Status is ListingStatus.Expired or ListingStatus.Cancelled)
        {
            <button class="btn btn-gold" disabled="@(_busy || !Ready)" @onclick="ReopenAsync"><Icon Name="repeat" /> Aynı ilanı tekrar aç</button>
        }
        @if (l.Status == ListingStatus.Open)
        {
            <button type="button" class="btn btn-outline-light"
                    data-share-title="PreBot"
                    data-share-text="@ShareText(l)"
                    data-share-url="@Navigation.ToAbsoluteUri($"/ilan/{Id}")"><Icon Name="share" /> Paylaş</button>
        }
        <a class="btn btn-link" href="/havuz">Havuza dön</a>
        <button type="button" class="btn btn-link text-dim small ms-auto" @onclick="() => _reportOpen = !_reportOpen"><Icon Name="flag" /> Şikâyet et</button>
    </div>

    @if (_reportOpen)
    {
        <div class="lobby-box mt-3 small">
            @if (_reportSent)
            {
                <div><Icon Name="check" /> Şikâyetin iletildi, teşekkürler. İncelenecek.</div>
            }
            else
            {
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Kimi?</label>
                        <select class="form-select form-select-sm" @bind="_reportTarget">
                            <option value="">İlanın kendisi</option>
                            @if (l.HostUserId != UserId)
                            {
                                <option value="@l.HostUserId">İlan sahibi: @_names.GetValueOrDefault(l.HostUserId, "Bir oyuncu")</option>
                            }
                            @foreach (var slot in _view.ActiveSlots.Where(s => s.UserId != UserId))
                            {
                                <option value="@slot.UserId">@_names.GetValueOrDefault(slot.UserId, "Bir oyuncu")</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Neden?</label>
                        <select class="form-select form-select-sm" @bind="_reportReason">
                            <option value="@ReportReason.NoShow">Katıldı ama gelmedi</option>
                            <option value="@ReportReason.Toxic">Hakaret, taciz, toksik davranış</option>
                            <option value="@ReportReason.FakeInfo">Sahte rank ya da Riot ID</option>
                            <option value="@ReportReason.Forbidden">Boost, hesap satışı, bahis, spam</option>
                            <option value="@ReportReason.Other">Diğer</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <input class="form-control form-control-sm" maxlength="300" placeholder="Kısa açıklama (isteğe bağlı)" @bind="_reportNote" />
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-light mt-2" disabled="@(_busy || !Ready)" @onclick="ReportAsync">Gönder</button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public int? Yeni { get; set; }

    /// <summary>
    /// ?katil={token} comes from the notification's "Katıl" button. The token is personal and short-lived,
    /// so only the player the notification was sent to is seated in one tap; anyone else who opens a
    /// copied link just sees the listing and its normal "Katıl" button.
    /// </summary>
    [SupplyParameterFromQuery] public string? Katil { get; set; }

    private ListingView? _view;
    private string? _viewerRiotId;
    private IReadOnlyDictionary<ulong, int> _noShows = new Dictionary<ulong, int>();
    private (int Count, DateTime? EarliestBackUtc) _waiting;
    private bool _reportOpen;
    private bool _reportSent;
    private string _reportTarget = "";
    private ReportReason _reportReason = ReportReason.NoShow;
    private string? _reportNote;
    private IReadOnlyDictionary<ulong, string> _names = new Dictionary<ulong, string>();
    private bool _busy;
    private string? _message;

    protected override async Task LoadAsync()
    {
        await LoadViewAsync();
        await AutoJoinFromNotificationAsync();
    }

    private async Task LoadViewAsync()
    {
        _viewerRiotId = await Pre.GetRiotIdAsync(UserId);
        _view = await Pre.GetListingViewAsync(Id);
        if (_view is not null && _view.Listing.GuildId != Communities.Web)
        {
            _view = null; // Discord-server listings are not shown on the website.
        }

        if (_view is not null)
        {
            _names = await Accounts.GetDisplayNamesAsync(
                _view.ActiveSlots.Select(s => s.UserId).Append(_view.Listing.HostUserId));
            _noShows = _view.Listing.HostUserId == UserId
                ? await Moderation.GetNoShowCountsAsync(_view.ActiveSlots.Select(s => s.UserId))
                : new Dictionary<ulong, int>();
            _waiting = _view.Listing.HostUserId == UserId ? await Pre.GetWaitingAfterMatchAsync(Id) : default;
        }
    }

    private bool _autoJoinDone;

    /// <summary>
    /// Handles ?katil={token} once the listing is loaded — only in the live (interactive) render, never during
    /// prerendering, so the seat is claimed exactly once.
    /// </summary>
    private async Task AutoJoinFromNotificationAsync()
    {
        if (Katil is null || _autoJoinDone || !RendererInfo.IsInteractive || _view is null)
        {
            return;
        }

        _autoJoinDone = true;
        var l = _view.Listing;
        var alreadyIn = l.HostUserId == UserId
            || _view.ActiveSlots.Any(s => s.UserId == UserId)
            || _view.LeftUserIds.Contains(UserId);
        if (l.Status == ListingStatus.Open && !alreadyIn && JoinTokens.IsValid(Katil, Id, UserId))
        {
            await JoinAsync();
        }

        Navigation.NavigateTo($"/ilan/{Id}", replace: true);
    }

    private async Task RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _message = null;
        _message = await action();

        // Show the result of our own action right away, without depending on the live-update event
        // (which this page may not be subscribed to yet, e.g. during the ?katil=1 auto-join).
        await LoadViewAsync();
        _busy = false;
    }

    private Task JoinAsync() => RunAsync(async () =>
    {
        var outcome = await Actions.ClaimAsync(Id, UserId);
        return outcome.Result switch
        {
            ClaimResult.Claimed or ClaimResult.ClaimedAndFilled => null,
            ClaimResult.RateLimited => ActionLimiter.RetryMessage(outcome.RetryAfter),
            ClaimResult.NeedsRiotId => "Katılmak için önce Riot ID'ni kaydet; ilan sahibi seni oyunda onunla davet edecek.",
            ClaimResult.HoldsOtherSeat => "Başka bir açık ilanda yerin var. Önce oradan vazgeç.",
            ClaimResult.Full => "Biri senden önce davrandı, kadro doldu.",
            ClaimResult.AlreadyJoined => "Bu ilandan daha önce ayrıldın, tekrar katılamazsın.",
            _ => "Bu ilan artık açık değil.",
        };
    });

    private Task LeaveAsync() => RunAsync(async () =>
        await Actions.LeaveAsync(Id, UserId) == LeaveResult.Left ? null : "Bu ilanda yerin yok.");

    private DateTime Now => DateTime.UtcNow;

    /// <summary>"Altın · Support" from what the player declared when joining.</summary>
    private static string Declared(SlotView slot) => (slot.Rank, slot.Role) switch
    {
        ({ } rank, { } role) => $"{TurkishNames.Of(rank)} · {TurkishNames.Of(role)} (beyan)",
        ({ } rank, null) => $"{TurkishNames.Of(rank)} (beyan)",
        (null, { } role) => $"{TurkishNames.Of(role)} (beyan)",
        _ => "rank belirtmemiş",
    };

    private Task InGameAsync() => RunAsync(async () =>
    {
        var until = await Actions.ReportInGameAsync(UserId, Id);
        return $"Tamam, iyi oyunlar. {Format.TimeLeft(until)} boyunca ilan bildirimi göndermeyeceğim; sonra bu ilan hâlâ açıksa " +
            "ya da sana uyan başka bir ilan varsa haber vereceğim. Erken biterse Havuz sayfasında \"Maç bitti, hazırım\"a bas.";
    });

    private Task DeclineAsync(ulong userId) => RunAsync(async () =>
        (await Actions.ReleaseByHostAsync(Id, UserId, userId, SeatReleaseReason.HostDeclined)).Result switch
        {
            HostActionResult.Done => null,
            HostActionResult.LimitReached => $"Bu ilanda en fazla {PreService.MaxDeclinesPerListing} kişiyi geri çevirebilirsin. Rank aralığını daraltıp ilanı yeniden açmayı dene.",
            _ => "Bu oyuncu artık ilanda değil.",
        });

    private Task NoShowAsync(ulong userId) => RunAsync(async () =>
        (await Actions.ReleaseByHostAsync(Id, UserId, userId, SeatReleaseReason.NoShow)).Result switch
        {
            HostActionResult.Done => null,
            HostActionResult.TooEarly => "Katıldıktan 3 dakika sonra 'Gelmedi' diyebilirsin; önce daveti kabul etmesine zaman tanı.",
            _ => "Bu oyuncu artık ilanda değil.",
        });

    private async Task ReportAsync()
    {
        if (!Limiter.TryAcquire(LimitedAction.Report, UserId, out var wait))
        {
            _message = ActionLimiter.RetryMessage(wait);
            return;
        }

        ulong? target = ulong.TryParse(_reportTarget, out var t) ? t : null;
        if (!await Moderation.ReportAsync(Id, UserId, target, _reportReason, _reportNote))
        {
            _message = "Şikâyet gönderilemedi.";
            return;
        }

        _reportSent = true;
    }

    private Task FilledViaLobbyAsync() => RunAsync(async () =>
        (await Actions.MarkFilledViaLobbyAsync(Id, UserId)).Result == HostActionResult.Done ? null : "İlan zaten kapalı.");

    private Task CancelAsync() => RunAsync(async () =>
        (await Actions.CancelAsync(Id, UserId)).Result == HostActionResult.Done ? null : "İlan zaten kapalı.");

    private async Task ReopenAsync()
    {
        _busy = true;
        _message = null;
        var result = await Actions.ReopenAsync(Id, UserId);
        _busy = false;
        if (result.Listing is not null)
        {
            Navigation.NavigateTo($"/ilan/{result.Listing.Id}?yeni={result.PotentialMatches}");
            return;
        }

        _message = result switch
        {
            { RetryAfter: { } wait } => ActionLimiter.RetryMessage(wait),
            { ExistingOpenListingId: int open } => $"Zaten açık bir ilanın var (#{open}). Önce onu kapat.",
            _ => "Bu ilan tekrar açılamadı.",
        };
    }

    // Shared from the browser itself (see prebot.js): iPhone only opens the share sheet inside the tap.
    private static string ShareText(Listing l) =>
        $"Flex için {Format.RoleLabel(l.Role)} lazım ({TurkishNames.RankRange(l.MinRank, l.MaxRank)}), " +
        $"{l.SlotsNeeded - l.SlotsFilled} kişi eksik! İlk basan alır:";
}
