@page "/ilan/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits UserComponentBase
@inject IJSRuntime JS
@inject PreBot.Web.Push.JoinTokens JoinTokens

<PageTitle>İlan · PreBot</PageTitle>

@if (Account is null)
{
    return;
}

<WaveAlertBanner UserId="UserId" />

@if (_view is null)
{
    <div class="pb-card">
        <h1 class="h4">İlan bulunamadı</h1>
        <p class="text-dim mb-0">Silinmiş olabilir. <a href="/havuz">Havuza dön</a>.</p>
    </div>
    return;
}

@{
    var l = _view.Listing;
    var isHost = l.HostUserId == UserId;
    var joined = _view.ActiveSlots.Any(s => s.UserId == UserId);
    var insider = isHost || joined;
    var left = !joined && _view.LeftUserIds.Contains(UserId);
    var missing = l.SlotsNeeded - l.SlotsFilled;
    var active = l.Status is ListingStatus.Open or ListingStatus.Filled;
    var myRiotId = isHost ? _view.HostRiotId : _view.ActiveSlots.FirstOrDefault(s => s.UserId == UserId)?.RiotId;
}

@if (Yeni is int matches && isHost && l.Status == ListingStatus.Open)
{
    <div class="alert alert-success">
        📢 İlanın açıldı.
        @(matches == 0
            ? "Şu an havuzda uygun kimse yok. İlan açık kaldıkça yeni gelenlere haber vereceğim; linki arkadaşlarınla da paylaşabilirsin."
            : $"Havuzda {matches} uygun kişi var, en uygunlardan başlayarak haber veriyorum.")
    </div>
}

<div class="pb-card @(l.Status == ListingStatus.Open ? "listing-card highlight" : "")">
    <div class="text-dim small mb-1">
        @(l.Status switch
        {
            ListingStatus.Open => $"🔎 Açık · {missing} kişi eksik · kapanış {Format.TimeLeft(l.ExpiresAtUtc)}",
            ListingStatus.Filled => "✅ Kadro tamam, iyi oyunlar!",
            ListingStatus.Expired => "⌛ İlanın süresi doldu",
            _ => "🚫 İlan kapatıldı",
        })
    </div>
    <h1 class="h3 mb-1">@Format.RoleLabel(l.Role) lazım</h1>
    <div class="mb-2">
        <span class="rank-chip ms-0">@TurkishNames.RankRange(l.MinRank, l.MaxRank)</span>
        <span class="rank-chip">@l.SlotsFilled / @l.SlotsNeeded dolu</span>
    </div>
    @if (l.Note is not null)
    {
        <div class="listing-note mb-2">“@l.Note”</div>
    }

    <div class="section-title mt-3">İlan sahibi</div>
    <div>
        <strong>@_names.GetValueOrDefault(l.HostUserId, "Bir oyuncu")</strong>
        @if (insider)
        {
            <RiotIdBadge RiotId="@_view.HostRiotId" Hint="@(isHost ? "Riot ID'ni aşağıdan ekle ki katılanlar seni bulsun." : "Riot ID'sini kaydetmemiş.")" />
        }
    </div>

    <div class="section-title">Katılanlar</div>
    @if (_view.ActiveSlots.Count == 0)
    {
        <div class="text-dim">Henüz kimse yok.</div>
    }
    else
    {
        @foreach (var slot in _view.ActiveSlots)
        {
            <div class="mb-1">
                <strong>@_names.GetValueOrDefault(slot.UserId, "Bir oyuncu")</strong>
                @if (insider)
                {
                    <RiotIdBadge RiotId="@slot.RiotId" Hint="Riot ID kayıtlı değil, kendisine sor." />
                }
            </div>
        }
    }

    @if (isHost && _view.ActiveSlots.Count > 0)
    {
        <div class="alert alert-info small mt-3 mb-0">
            Katılanın Riot ID'sine dokun (kopyalanır) → oyunda <strong>Arkadaş ekle</strong>'ye yapıştır → lobine davet et.
        </div>
    }
    @if (left && l.Status == ListingStatus.Open)
    {
        <div class="alert alert-secondary small mt-3 mb-0">Bu ilandan ayrıldın, yerin başkasına açıldı. Aynı ilana tekrar katılamazsın.</div>
    }
    @if (joined)
    {
        <div class="alert alert-info small mt-3 mb-0">
            İlan sahibi seni oyunda davet edecek; arkadaşlık isteği gelince kabul et. Beklemek istemezsen onun Riot ID'sine dokunup
            sen ekle. Gelemeyeceksen lütfen <strong>Vazgeç</strong>'e bas, başkası alsın.
        </div>
    }
    @if (insider && active && myRiotId is null)
    {
        <RiotIdPrompt UserId="UserId"
                      Hint="@(isHost ? "Katılanlar seni oyunda bununla bulacak." : "İlan sahibi seni oyunda bununla davet edecek.")"
                      OnSaved="_ => LoadViewAsync()" />
    }

    @if (_message is not null)
    {
        <div class="alert alert-warning mt-3 mb-0">@_message</div>
    }

    <div class="d-flex flex-wrap gap-2 mt-3">
        @if (l.Status == ListingStatus.Open && !insider && !left)
        {
            <button class="btn btn-gold btn-lg" disabled="@(_busy || !Ready)" @onclick="JoinAsync">Katıl</button>
        }
        @if (joined && l.Status is ListingStatus.Open or ListingStatus.Filled)
        {
            <button class="btn btn-outline-light" disabled="@(_busy || !Ready)" @onclick="LeaveAsync">Vazgeç</button>
        }
        @if (isHost && l.Status is ListingStatus.Open or ListingStatus.Filled)
        {
            @if (_view.ActiveSlots.Count > 0)
            {
                <button class="btn btn-outline-light" disabled="@(_busy || !Ready)" @onclick="NoShowAsync">Gelmedi, yeniden ara</button>
            }
            <button class="btn btn-outline-danger" disabled="@(_busy || !Ready)" @onclick="CancelAsync">İlanı kapat</button>
        }
        @if (isHost && l.Status is ListingStatus.Expired or ListingStatus.Cancelled)
        {
            <button class="btn btn-gold" disabled="@(_busy || !Ready)" @onclick="ReopenAsync">🔁 Aynı ilanı tekrar aç</button>
        }
        @if (l.Status == ListingStatus.Open)
        {
            <button class="btn btn-outline-light" @onclick="CopyLinkAsync">@(_copied ? "Kopyalandı ✓" : "🔗 Linki paylaş")</button>
        }
        <a class="btn btn-link" href="/havuz">Havuza dön</a>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public int? Yeni { get; set; }

    /// <summary>
    /// ?katil={token} comes from the notification's "Katıl" button. The token is personal and short-lived,
    /// so only the player the notification was sent to is seated in one tap; anyone else who opens a
    /// copied link just sees the listing and its normal "Katıl" button.
    /// </summary>
    [SupplyParameterFromQuery] public string? Katil { get; set; }

    private ListingView? _view;
    private IReadOnlyDictionary<ulong, string> _names = new Dictionary<ulong, string>();
    private bool _busy;
    private bool _copied;
    private string? _message;

    protected override async Task LoadAsync()
    {
        await LoadViewAsync();
        await AutoJoinFromNotificationAsync();
    }

    private async Task LoadViewAsync()
    {
        _view = await Pre.GetListingViewAsync(Id);
        if (_view is not null && _view.Listing.GuildId != Communities.Web)
        {
            _view = null; // Discord-server listings are not shown on the website.
        }

        if (_view is not null)
        {
            _names = await Accounts.GetDisplayNamesAsync(
                _view.ActiveSlots.Select(s => s.UserId).Append(_view.Listing.HostUserId));
        }
    }

    private bool _autoJoinDone;

    /// <summary>
    /// Handles ?katil={token} once the listing is loaded — only in the live (interactive) render, never during
    /// prerendering, so the seat is claimed exactly once.
    /// </summary>
    private async Task AutoJoinFromNotificationAsync()
    {
        if (Katil is null || _autoJoinDone || !RendererInfo.IsInteractive || _view is null)
        {
            return;
        }

        _autoJoinDone = true;
        var l = _view.Listing;
        var alreadyIn = l.HostUserId == UserId
            || _view.ActiveSlots.Any(s => s.UserId == UserId)
            || _view.LeftUserIds.Contains(UserId);
        if (l.Status == ListingStatus.Open && !alreadyIn && JoinTokens.IsValid(Katil, Id, UserId))
        {
            await JoinAsync();
        }

        Navigation.NavigateTo($"/ilan/{Id}", replace: true);
    }

    private async Task RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _message = null;
        _message = await action();

        // Show the result of our own action right away, without depending on the live-update event
        // (which this page may not be subscribed to yet, e.g. during the ?katil=1 auto-join).
        await LoadViewAsync();
        _busy = false;
    }

    private Task JoinAsync() => RunAsync(async () =>
        (await Actions.ClaimAsync(Id, UserId)).Result switch
        {
            ClaimResult.Claimed or ClaimResult.ClaimedAndFilled => null,
            ClaimResult.Full => "Biri senden önce davrandı, kadro doldu.",
            ClaimResult.AlreadyJoined => "Bu ilandan daha önce ayrıldın, tekrar katılamazsın.",
            _ => "Bu ilan artık açık değil.",
        });

    private Task LeaveAsync() => RunAsync(async () =>
        await Actions.LeaveAsync(Id, UserId) == LeaveResult.Left ? null : "Bu ilanda yerin yok.");

    private Task NoShowAsync() => RunAsync(async () =>
        (await Actions.ReportNoShowAsync(Id, UserId)).Result == HostActionResult.Done
            ? null
            : "Çıkarılacak kimse yok.");

    private Task CancelAsync() => RunAsync(async () =>
        (await Actions.CancelAsync(Id, UserId)).Result == HostActionResult.Done ? null : "İlan zaten kapalı.");

    private async Task ReopenAsync()
    {
        _busy = true;
        _message = null;
        var result = await Actions.ReopenAsync(Id, UserId);
        _busy = false;
        if (result.Listing is not null)
        {
            Navigation.NavigateTo($"/ilan/{result.Listing.Id}?yeni={result.PotentialMatches}");
            return;
        }

        _message = result.ExistingOpenListingId is int open
            ? $"Zaten açık bir ilanın var (#{open}). Önce onu kapat."
            : "Bu ilan tekrar açılamadı.";
    }

    private async Task CopyLinkAsync()
    {
        _copied = await JS.InvokeAsync<bool>("prebot.copy", Navigation.ToAbsoluteUri($"/ilan/{Id}").ToString());
    }
}
