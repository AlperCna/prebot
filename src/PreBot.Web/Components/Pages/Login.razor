@page "/giris"
@inject IWebHostEnvironment Env
@inject ExternalProviders Providers
@inject IConfiguration Config

<PageTitle>Giriş · PreBot</PageTitle>

<div class="pb-card mx-auto mt-4" style="max-width: 26rem">
    <h1 class="h4 mb-3">Giriş yap</h1>

    @if (Hata is not null)
    {
        <div class="alert alert-warning py-2 small">
            @(Hata switch
            {
                "isim" => "İsim en az 2 karakter olmalı.",
                "iptal" => "Giriş iptal edildi ya da tamamlanamadı. Tekrar dene.",
                "kabul" => "Devam etmek için kutucuğu işaretlemelisin.",
                "kod" => "Davet kodu yanlış.",
                "engel" => "Bu hesap kapatıldı. Bir yanlışlık olduğunu düşünüyorsan İletişim sayfasındaki adrese yaz.",
                _ => "Giriş tamamlanamadı. Tekrar dene.",
            })
        </div>
    }

    @if (AuthEndpoints.InviteEnabled(Config))
    {
        <form method="post" action="/auth/invite-login" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/havuz")" />
            <p class="text-dim small">🎟️ <strong>Davetli deneme.</strong> Sana verilen kodu ve oyundaki gibi tanınacağın bir isim yaz.</p>
            <label class="form-label" for="invite-name">Görünen isim</label>
            <input id="invite-name" name="name" class="form-control mb-2" maxlength="32" placeholder="ör. Alper" required />
            <label class="form-label" for="invite-code">Davet kodu</label>
            <input id="invite-code" name="code" class="form-control mb-2" maxlength="32" autocomplete="off" required />
            <label class="form-check small mb-3">
                <input class="form-check-input" type="checkbox" name="kabul" value="1" required />
                <span class="form-check-label">
                    <a href="/gizlilik" target="_blank">Aydınlatma metnini</a> okudum,
                    <a href="/kosullar" target="_blank">Kullanım Koşulları</a>'nı kabul ediyorum ve 16 yaşından büyüğüm.
                </span>
            </label>
            <button type="submit" class="btn btn-gold w-100">Giriş yap</button>
        </form>
        @if (Providers.All.Count > 0)
        {
            <hr class="my-4" />
        }
    }

    @if (Providers.All.Count > 0)
    {
        <form method="get" data-enhance="false" class="d-grid gap-2">
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/havuz")" />
            <label class="form-check small mb-2">
                <input class="form-check-input" type="checkbox" name="kabul" value="1" required />
                <span class="form-check-label">
                    <a href="/gizlilik" target="_blank">Aydınlatma metnini</a> okudum,
                    <a href="/kosullar" target="_blank">Kullanım Koşulları</a>'nı kabul ediyorum ve 16 yaşından büyüğüm.
                </span>
            </label>
            @foreach (var p in Providers.All)
            {
                <button type="submit" formaction="/auth/login/@p.Name"
                        class="btn @(p.Name == "google" ? "btn-light" : "btn-outline-light") btn-lg">
                    @(p.Name == "google" ? "🔵 " : "💬 ")@p.Label
                </button>
                @if (p.Hint is not null)
                {
                    <div class="text-dim small text-center mt-n1">@p.Hint</div>
                }
            }
        </form>
        <p class="text-dim small mt-3 mb-0">
            Yalnızca hesap kimliğini ve görünen adını alırız; e-posta adresini almayız. <a href="/gizlilik">Gizlilik</a>
        </p>
    }
    else if (!Env.IsDevelopment() && !AuthEndpoints.InviteEnabled(Config))
    {
        <p class="text-dim mb-0">Giriş henüz yapılandırılmadı.</p>
    }

    @if (Env.IsDevelopment())
    {
        @if (Providers.All.Count > 0)
        {
            <hr class="my-4" />
        }
        <p class="text-dim small">
            🧪 <strong>Test girişi</strong> (yalnızca senin bilgisayarında çalışır). Herhangi bir isim yaz.
            İki farklı tarayıcıda iki farklı isimle girip iki oyuncu gibi deneyebilirsin.
        </p>
        <form method="post" action="/auth/dev-login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label class="form-label" for="name">Görünen isim</label>
            <input id="name" name="name" class="form-control mb-3" maxlength="32" placeholder="ör. Alper" required autofocus />
            <button type="submit" class="btn btn-gold w-100">Test girişi yap</button>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Hata { get; set; }
}
