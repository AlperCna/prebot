@page "/bildirimler"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits UserComponentBase
@inject SubscriptionService Subscriptions
@inject PreBotOptions Options

<PageTitle>Bildirimler · PreBot</PageTitle>

@if (Account is null)
{
    return;
}

<h1 class="h3 mb-3">Bildirimler</h1>

<div class="section-title mt-0">Bu cihaz</div>
<PushToggle UserId="UserId" />

<div class="section-title">Sustur</div>
<div class="pb-card">
    @if (_mutedUntil is { } until)
    {
        <div class="mb-2"><Icon Name="bell-off" /> Başka ilanlar için bildirimler <strong>@TurkeyTime.ToLocal(until).ToString("HH:mm")</strong>'e kadar susturuldu.
            Kendi ilanınla ilgili haberler gelmeye devam eder.</div>
        <button class="btn btn-sm btn-gold" disabled="@(!Ready)" @onclick="() => MuteAsync(null)">Bildirimleri şimdi aç</button>
    }
    else
    {
        <div class="text-dim small mb-2">Bir süre rahatsız edilmek istemiyorsan susturabilirsin. Kendi ilanınla ilgili haberler yine gelir.</div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-outline-light" disabled="@(!Ready)" @onclick="() => MuteAsync(TimeSpan.FromHours(1))">1 saat sustur</button>
            <button class="btn btn-sm btn-outline-light" disabled="@(!Ready)" @onclick="MuteTonightAsync">Bu gece sustur (sabaha kadar)</button>
        </div>
    }
</div>

<div class="section-title">Bana haber ver</div>
<div class="pb-card">
    <p class="text-dim small">
        Her akşam "Müsaitim"e basmak zorunda değilsin. Belirlediğin saatlerde sana uyan bir ilan açılırsa haber veririm.
        Önce o an müsait olanlara sorulur; yeterince kişi yoksa sana da hemen haber gider.
    </p>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="alert-on" @bind="_enabled" />
        <label class="form-check-label" for="alert-on">Bana haber ver</label>
    </div>

    <div class="row g-2">
        <div class="col-6">
            <label class="form-label">Rol</label>
            <select class="form-select" @bind="_role" disabled="@(!_enabled)">
                @foreach (var r in Format.Roles)
                {
                    <option value="@r">@Format.RoleOption(r)</option>
                }
            </select>
        </div>
        <div class="col-6">
            <label class="form-label">Flex rankın</label>
            <select class="form-select" @bind="_rank" disabled="@(!_enabled)">
                @foreach (var k in Format.Ranks)
                {
                    <option value="@k">@TurkishNames.Of(k)</option>
                }
            </select>
        </div>
        <div class="col-6">
            <label class="form-label">Başlangıç saati</label>
            <select class="form-select" @bind="_from" disabled="@(!_enabled)">
                @for (var h = 0; h < 24; h++)
                {
                    <option value="@h">@h.ToString("00"):00</option>
                }
            </select>
        </div>
        <div class="col-6">
            <label class="form-label">Bitiş saati</label>
            <select class="form-select" @bind="_to" disabled="@(!_enabled)">
                @for (var h = 0; h < 24; h++)
                {
                    <option value="@h">@h.ToString("00"):00</option>
                }
            </select>
        </div>
    </div>

    <div class="text-dim small mt-2">
        Türkiye saati. Gece yarısını geçebilir (ör. 20:00 – 02:00); ikisi aynıysa bütün gün.
        En fazla @Options.AlertCooldownMinutes dakikada bir, günde en fazla @Options.AlertDailyLimit bildirim.
    </div>

    @if (_enabled && _devices == 0)
    {
        <div class="alert alert-warning small mt-3 mb-0">Bu uyarılar bildirim olarak gelir. Önce yukarıdan bu cihazda bildirimleri aç.</div>
    }

    @if (_message is not null)
    {
        <div class="alert alert-success py-2 small mt-3 mb-0">@_message</div>
    }

    <button class="btn btn-gold mt-3" disabled="@(!Ready)" @onclick="SaveAsync">Kaydet</button>
</div>

@code {
    private bool _enabled;
    private Role _role = Role.Support;
    private Rank _rank = Rank.Gold;
    private int _from = 19;
    private int _to = 0;
    private int _devices;
    private bool _loaded;
    private string? _message;

    protected override async Task LoadAsync()
    {
        _devices = await Subscriptions.CountPushDevicesAsync(UserId);
        _mutedUntil = await Pre.GetMutedUntilAsync(UserId);
        if (_loaded)
        {
            return; // don't overwrite what the user is editing
        }

        _loaded = true;
        if (await Subscriptions.GetAlertAsync(Communities.Web, UserId) is { } alert)
        {
            (_enabled, _role, _rank, _from, _to) = (alert.Enabled, alert.Role, alert.Rank, alert.FromHour, alert.ToHour);
        }
    }

    private async Task SaveAsync()
    {
        await Subscriptions.SaveAlertAsync(Communities.Web, UserId, _role, _rank, _from, _to, _enabled);
        _devices = await Subscriptions.CountPushDevicesAsync(UserId);
        _message = _enabled
            ? $"Kaydedildi. {_from:00}:00 – {_to:00}:00 arası {TurkishNames.Of(_role)} / {TurkishNames.Of(_rank)} ilanlarında haber vereceğim."
            : "Kaydedildi. 'Bana haber ver' kapalı.";
    }

    private DateTime? _mutedUntil;

    private async Task MuteAsync(TimeSpan? duration)
    {
        await Pre.MuteAsync(UserId, duration is { } d ? DateTime.UtcNow + d : null);
        _mutedUntil = await Pre.GetMutedUntilAsync(UserId);
    }

    // Until 10:00 Turkey time next morning (Turkey is UTC+3 all year).
    private Task MuteTonightAsync()
    {
        var local = TurkeyTime.ToLocal(DateTime.UtcNow);
        var tenAm = local.Date.AddHours(local.Hour < 10 ? 10 : 34);
        return MuteAsync(tenAm - local);
    }
}
