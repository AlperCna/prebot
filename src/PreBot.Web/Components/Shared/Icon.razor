@* Small line icons (drawn for PreBot, 24×24 grid, colour follows the text). Usage: <Icon Name="bell" /> *@
<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@StrokeWidth"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "bell":
            <path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z" /><path d="M10 20a2 2 0 0 0 4 0" />
            break;
        case "bell-off":
            <path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z" /><path d="M10 20a2 2 0 0 0 4 0" /><path d="M4 4l16 16" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.5" /><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7" /><path d="M18 14c2 .6 3.5 2.6 3.5 5" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5" />
            break;
        case "x":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        case "share":
            <circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6" />
            break;
        case "copy":
            <rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
            break;
        case "flag":
            <path d="M5 21V4" /><path d="M5 4h11l-2 4 2 4H5" />
            break;
        case "shield":
            <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" />
            break;
        case "download":
            <path d="M12 4v11" /><path d="M7 10l5 5 5-5" /><path d="M5 20h14" />
            break;
        case "gamepad":
            <rect x="3" y="7" width="18" height="11" rx="4" /><path d="M8 10.5v4M6 12.5h4" /><path d="M15 12h.01M17.5 14.5h.01" stroke-width="2.6" />
            break;
        case "alert":
            <path d="M12 3.5l9.5 16.5h-19z" /><path d="M12 10v4.5" /><path d="M12 17.5h.01" stroke-width="2.6" />
            break;
        case "repeat":
            <path d="M4 12a8 8 0 0 1 14-5.3L20 9" /><path d="M20 4v5h-5" /><path d="M20 12a8 8 0 0 1-14 5.3L4 15" /><path d="M4 20v-5h5" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" />
            break;
        case "arrow-right":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        case "megaphone":
            <path d="M3 10v4h3l7 4V6l-7 4z" /><path d="M16.5 9a4 4 0 0 1 0 6" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
        case "log-in":
            <path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4" /><path d="M10 16l4-4-4-4" /><path d="M14 12H4" />
            break;
        case "phone":
            <rect x="7" y="3" width="10" height="18" rx="2" /><path d="M11 18h2" />
            break;
        case "chart":
            <path d="M5 20V11M12 20V5M19 20v-7" />
            break;
        case "ticket":
            <path d="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4z" /><path d="M14 7v10" stroke-dasharray="2 2" />
            break;
        case "message":
            <path d="M4 5h16v11H9l-5 4z" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 7.5h.01" stroke-width="2.6" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public double StrokeWidth { get; set; } = 1.8;
}
