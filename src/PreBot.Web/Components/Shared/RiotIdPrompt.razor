@inject PreService Pre
@inject LiveUpdates Live

@* Inline "add your Riot ID" box, shown right where the Riot ID is needed (no trip to the profile page). *@
<div class="riot-prompt">
    <div class="small mb-1">🎮 <strong>Riot ID'ni ekle</strong> · @Hint</div>
    <div class="d-flex gap-2">
        <input class="form-control form-control-sm" maxlength="22" placeholder="ör. Oyuncu#TR1" @bind="_value" @bind:event="oninput"
               @onkeydown="OnKeyDown" aria-label="Riot ID" />
        <button class="btn btn-sm btn-gold flex-shrink-0" disabled="@(_busy || string.IsNullOrWhiteSpace(_value))" @onclick="SaveAsync">Kaydet</button>
    </div>
    @if (_error is not null)
    {
        <div class="small text-warning mt-1">@_error</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ulong UserId { get; set; }
    [Parameter] public string Hint { get; set; } = "Oyunda seni bulup davet edebilsinler diye.";
    [Parameter] public EventCallback<string> OnSaved { get; set; }

    private string? _value;
    private string? _error;
    private bool _busy;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (!RiotIdValidator.TryNormalize(_value, out var riotId))
        {
            _error = "İsim#ETİKET biçiminde yaz, ör. Oyuncu#TR1.";
            return;
        }

        _busy = true;
        _error = null;
        await Pre.SetRiotIdAsync(UserId, riotId);
        Live.PublishChanged(); // listing pages show the new Riot ID right away
        _busy = false;
        await OnSaved.InvokeAsync(riotId);
    }
}
