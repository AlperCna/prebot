@* First-run checklist on the pool page. Disappears once everything is set up. *@
@if (!AllDone && !_hidden)
{
    <div class="pb-card getting-started mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div class="fw-semibold">🚀 Başlarken</div>
            <button class="btn btn-sm btn-link text-dim p-0" @onclick="() => _hidden = true">Gizle</button>
        </div>
        <ol class="checklist mb-0 mt-2">
            <li class="@(HasRiotId ? "done" : "")">
                @(HasRiotId ? "✅" : "1️⃣") <strong>Riot ID'ni ekle</strong>: katıldığın ilanda sahibi seni oyunda davet edebilsin.
                @if (!HasRiotId)
                {
                    <div class="mt-2"><RiotIdPrompt UserId="UserId" OnSaved="_ => OnChanged.InvokeAsync()" /></div>
                }
            </li>
            <li class="@(HasPush ? "done" : "")">
                @(HasPush ? "✅" : "2️⃣") <strong>Bildirimleri aç</strong>: site kapalıyken de "Destek lazım!" haberi gelsin.
                @if (!HasPush)
                {
                    <a href="/bildirimler" class="ms-1">Aç →</a>
                }
            </li>
            <li class="@(HasWay ? "done" : "")">
                @(HasWay ? "✅" : "3️⃣") <strong>"Şu an müsaitim" de</strong> ya da her akşam uğraşmamak için
                <a href="/bildirimler">"Bana haber ver"i kur</a>.
            </li>
        </ol>
    </div>
}

@code {
    [Parameter, EditorRequired] public ulong UserId { get; set; }
    [Parameter] public bool HasRiotId { get; set; }
    [Parameter] public bool HasPush { get; set; }
    [Parameter] public bool HasWay { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _hidden;

    private bool AllDone => HasRiotId && HasPush && HasWay;
}
