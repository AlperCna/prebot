@inject IJSRuntime JS

@if (RiotId is not null)
{
    <button type="button" class="rank-chip riot-copy" title="Kopyala: oyunda Arkadaş ekle'ye yapıştır" @onclick="CopyAsync">
        🎮 @RiotId <span class="copy-hint">@(_copied ? "✓ kopyalandı" : "kopyala")</span>
    </button>
}
else
{
    <span class="text-dim small ms-1">(@Hint)</span>
}

@code {
    [Parameter] public string? RiotId { get; set; }
    [Parameter] public string Hint { get; set; } = "Riot ID kayıtlı değil.";

    private bool _copied;

    private async Task CopyAsync()
    {
        try
        {
            _copied = await JS.InvokeAsync<bool>("prebot.copy", RiotId);
        }
        catch (JSException)
        {
            _copied = false;
        }
    }
}
